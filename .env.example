# Copy to .env for local development.
OPENLARDER_DATABASE_URL=postgresql+psycopg://openlarder:openlarder@localhost:54320/openlarder
OPENLARDER_ENVIRONMENT=development

# Sign-in through Authgear. Leave all of these unset to run without sign-in;
# set some but not all and the app refuses to start. See README.md.
# OPENLARDER_OIDC_ISSUER=https://auth.openlarder.com
# OPENLARDER_OIDC_CLIENT_ID=
# OPENLARDER_OIDC_CLIENT_SECRET=
# OPENLARDER_SESSION_SECRET=
# OPENLARDER_PUBLIC_URL=
